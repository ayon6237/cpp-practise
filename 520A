#include <bits/stdc++.h>
using namespace std;

int main() {
    int n;
    cin >> n;

    string s;
    cin >> s;

    vector<bool> found(26, false);

    for (char c : s) {
        c = tolower(c);
        if (c >= 'a' && c <= 'z') {
            found[c - 'a'] = true;
        }
    }

    for (int i = 0; i < 26; i++) {
        if (!found[i]) {
            cout << "NO" << endl;
            return 0;
        }
    }

    cout << "YES" << endl;

    return 0;
}
