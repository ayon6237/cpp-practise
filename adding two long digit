#include<iostream>
using namespace std;
main(){
    int m,n,carry=0;
    cin>>m>>n;

    int a[m],b[n];
    int size = max(m,n)+1;
    int c[size];
    int k=size-1;
    int i=m-1;
    int j=n-1;

    for(int i=0;i<m;i++){
        cin>>a[i];
    }
    for(int i=0;i<n;i++){
        cin>>b[i];
    }

    while(i>=0 || j>=0){
        int x = (i>=0 ? a[i] : 0);
        int y = (j>=0 ? b[j] : 0);
        int sum = (x+y+carry);
        c[k] = sum % 10;
        carry = sum/10;

        i--;
        j--;
        k--;
    }

    c[k] = carry;

    if(c[k] != 0){
        cout<<c[k];
    }

    for(int p = k+1; p<size; p++){
        cout<<c[p];
    }



    return 0;
}
