#include <iostream>
using namespace std;
int main() {
    int n,i,num1,num2,num3;
    cin>>n;
    
    for(i=0;i<n;i++) {
        cin>>num1>>num2>>num3;
        if((num1==num2+num3) || (num2==num1+num3) || (num3==num1+num2)) {
            cout<<"YES"<<endl;
        }else{
            cout<<"NO"<<endl;
        }
    }

    return 0;
}